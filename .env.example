# ===========================================================================
# Warraq وراق — Environment Configuration Template
#
# Copy this file to `.env` (frontend/build) and set the values per environment.
# NEVER commit real secrets. Every value below is a placeholder.
#
# Two API planes exist in the desktop app:
#   LOCAL  — the pdf/python server on 127.0.0.1 (started by the Tauri app)
#   REMOTE — the subscription/payment/entitlement server (must NOT be localhost
#            in staging/production)
# ===========================================================================

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
#   Remote calls point at your local python-server so the full stack runs on
#   one machine. Nothing here is secret.
# ---------------------------------------------------------------------------
# VITE_DEV_MODE=false            # DO NOT re-add a client feature bypass
# VITE_REMOTE_API_BASE_URL=http://127.0.0.1:8002
# VITE_ENTITLEMENT_PUBLIC_KEY=<base64 public key (dev keypair ok for local)>

# ---------------------------------------------------------------------------
# STAGING
#   A real remote server (e.g. https://staging-api.warraq.app). Remote calls
#   never touch localhost. Uses a dedicated staging signing keypair.
# ---------------------------------------------------------------------------
# VITE_DEV_MODE=false
# VITE_REMOTE_API_BASE_URL=https://staging-api.warraq.app
# VITE_ENTITLEMENT_PUBLIC_KEY=<base64 STAGING public key>

# ---------------------------------------------------------------------------
# PRODUCTION
#   Remote calls hit the production API only. Mock payment and dev bypass are
#   disabled by the server (ENVIRONMENT=production). Requires the PRODUCTION
#   signing keypair.
# ---------------------------------------------------------------------------
# VITE_DEV_MODE=false
# VITE_REMOTE_API_BASE_URL=https://api.warraq.app
# VITE_ENTITLEMENT_PUBLIC_KEY=<base64 PRODUCTION public key>


# ---------------------------------------------------------------------------
# BACKEND SERVER (python-server) — set these on the server, NOT in the repo
# ---------------------------------------------------------------------------
# ENVIRONMENT=development|staging|production
# PORT=8002
# LAUNCH_ACCESS_ENABLED=true
# LAUNCH_ACCESS_UNTIL=2027-03-01T00:00:00
# OFFLINE_GRACE_DAYS=7
#
# CORS — '*' is for local development only. Production MUST list explicit origins:
# CORS_ALLOW_ORIGINS=https://warraq.app,https://www.warraq.app
#
# Payment (PayMob) — production requires these; checkout fails closed otherwise
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID_EGYPT=
# PAYMOB_INTEGRATION_ID_SA=
# PAYMOB_HMAC_SECRET=
#
# Entitlement signing (Ed25519) — see python-server/scripts/generate_entitlement_keys.py
# ENTITLEMENT_PRIVATE_KEY=<base64 private key — SERVER ENV ONLY, never committed>
# ENTITLEMENT_PRIVATE_KEY_FILE=<path to private key file — server env only>
#
# Payment (Gumroad) — V1 provider. Desktop never holds these; server env only.
#   Product permalinks match the "warraq-*" products in your Gumroad account.
# GUMROAD_ACCESS_TOKEN=<Gumroad account/product access token>
# GUMROAD_PRODUCT_MONTHLY=warraq-monthly
# GUMROAD_PRODUCT_ANNUAL=warraq-annual
# GUMROAD_PRODUCT_LIFETIME=warraq-lifetime
# GUMROAD_REVERIFY_COOLDOWN_SECONDS=43200
# GUMROAD_VERIFY_URL=https://api.gumroad.com/v2/licenses/verify  # override for staging/tests
# Gumroad webhook URL to set on the product dashboard: https://api.warraq.app/api/payment/gumroad/webhook