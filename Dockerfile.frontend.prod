FROM node:20-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_REMOTE_API_BASE_URL
ARG VITE_ENTITLEMENT_PUBLIC_KEY
ENV VITE_USE_DOCKER_BACKEND=true
ENV VITE_LOCAL_API_BASE_URL=
ENV VITE_REMOTE_API_BASE_URL=${VITE_REMOTE_API_BASE_URL}
ENV VITE_ENTITLEMENT_PUBLIC_KEY=${VITE_ENTITLEMENT_PUBLIC_KEY}

RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
